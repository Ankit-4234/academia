# Copy this file to ".env" in the project root (or in /server) and fill it in.
# NEVER commit .env or share these values.

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash).
# Production example: https://your-site.vercel.app
CLIENT_URL=http://localhost:5180

# MongoDB Atlas connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/academia?retryWrites=true&w=majority
MONGODB_URI=

# Reserved for a future admin login (not used yet).
JWT_SECRET=
